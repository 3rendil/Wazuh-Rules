<group name="rule_exclusion,">
<!-- ========== Windows Custom Exclusion rules =========== -->
<rule id="990001" level="1">
    <if_sid>112155</if_sid>
	<field name="win.eventdata.image" type="pcre2">(?i)^C:\\\\WINDOWS\\\\system32\\\\services\.exe$</field>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)HKLM\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\[^\\\\]+\\\\(ImagePath|Type|Start)</field>
    <field name="win.eventdata.user" type="pcre2">(?i)^NT AUTHORITY\\\\SYSTEM$|^AUTORITE NT\\\\Système$</field>
    <description>Exclusion SOCFortress - service.exe modifying standard services (T1543.003)</description>
    <options>no_full_log</options>
  </rule>
  
  <rule id="990002" level="1">
    <if_sid>112143</if_sid>
	<field name="win.eventdata.image" type="pcre2">(?i)^C:\\\\WINDOWS\\\\system32\\\\services\.exe$</field>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)HKLM\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\[^\\\\]+\\\\(ImagePath|Type|Start)</field>
    <field name="win.eventdata.user" type="pcre2">(?i)^NT AUTHORITY\\\\SYSTEM$|^AUTORITE NT\\\\Système$</field>
    <description>Exclusion SOCFortress - service.exe Service Registry Event</description>
    <options>no_full_log</options>
  </rule>
  
  <!-- Exclude OneDrive Process Creation (T1036 Masquerading) -->
  <rule id="990003" level="1">
    <if_sid>100606</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\\\Microsoft\\\\OneDrive\\\\[^\\\\]+\\\\(OneDrive|OneDriveSetup|OneDriveStandaloneUpdater|Microsoft\.SharePoint|OneDriveLauncher|FileCoAuth|FileSyncConfig)\.exe$|\\\\Microsoft\\\\OneDrive\\\\(OneDrive|OneDriveSetup|OneDriveStandaloneUpdater|Microsoft\.SharePoint|OneDriveLauncher|FileCoAuth|FileSyncConfig)\.exe$</field>
    <field name="win.eventdata.company" type="pcre2">(?i)^Microsoft Corporation$</field>
    <description>Exclusion SOCFortress - OneDrive legitimate process creation (T1036)</description>
    <options>no_full_log</options>
  </rule>

  <!-- Exclude Legitimate Windows Update Registry Event (T1053 Scheduled Task) -->
  <rule id="990004" level="1">
    <if_sid>112120</if_sid>
	<field name="win.eventdata.image" type="pcre2">(?i)^C:\\\\WINDOWS\\\\system32\\\\svchost\.exe$</field>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)HKLM\\\\SOFTWARE\\\\Microsoft\\\\Windows NET\\\\CurrentVersion\\\\Schedule\\\\TaskCache\\\\Tree\\\\Microsoft\\\\Windows\\\\WindowsUpdate\\\\[^\\\\]+\\\\Index|HKLM\\\\SOFTWARE\\\\Microsoft\\\\Windows NET\\\\CurrentVersion\\\\Schedule\\\\TaskCache\\\\Tree\\\\Microsoft\\\\Windows\\\\UpdateOrchestrator\\\\[^\\\\]+\\\\Index</field>
    <field name="win.eventdata.user" type="pcre2">(?i)^NT AUTHORITY\\\\SYSTEM$|^AUTORITE NT\\\\Système$</field>
    <description>Exclusion SOCFortress - Windows Update legitimate Registry Event (T1053)</description>
    <options>no_full_log</options>
  </rule>

  <!-- Exclude Legitimate MSEdge Registry Event -->
  <rule id="990005" level="1">
    <if_sid>112143</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)^C:\\\\Program Files \(x86\)\\\\Microsoft\\\\Edge\\\\Application\\\\msedge\.exe$</field>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)HKLM\\\\System\\\\CurrentControlSet\\\\Services\\\\bam\\\\State\\\\UserSettings\\\\[^\\\\]+\\\\\\\\Device\\\\[^\\\\]+\\\\Program Files \(x86\)\\\\Microsoft\\\\Edge\\\\Application\\\\msedge\.exe$</field>
    <description>Exclusion SOCFortress - MSEdge legitimate Registry Event (T1053)</description>
    <options>no_full_log</options>
  </rule>

  <!-- Lower Sev for Sysmon - Event 13 - RegistryEvent. Triggers many noises and FPs at boot or logon -->
  <rule id="990006" level="1">
    <if_sid>112143,112120</if_sid>
	<!--<if_matched_sid>112143</if_matched_sid>-->
	<!--<same_field>win.eventdata.image</same_field>-->
	<field name="win.eventdata.image" type="pcre2">(?i)^C:\\\\Windows\\\\system32\\\\(svchost\.exe|services\.exe)$</field>
    <description>Exclude noise: Multiple Sysmon Event 13 from svchost.exe or services.exe (e.g., during startup)</description>
    <options>no_full_log</options>
  </rule>

  <!-- Lower Sev for SearchApp File Dropped. Triggers many noises and FPs -->
  <rule id="990007" level="1">
    <if_sid>92200</if_sid>
	<field name="win.eventdata.image" type="pcre2">(?i)^C:\\\\WINDOWS\\\\SystemApps\\\\[^\\\\]+\\\\SearchApp.exe$</field>
    <!--<field name="win.eventdata.user" type="pcre2" negate="yes">(?i)^NT AUTHORITY\\\\SYSTEM$|^AUTORITE NT\\\\Système$</field>-->
    <description>Exclude SearchApp False Positive</description>
    <options>no_full_log</options>
  </rule>

  <rule id="990008" level="1">
    <if_sid>112143</if_sid>
	<field name="win.eventdata.image" type="pcre2">(?i)^C:\\\\Windows\\\\system32\\\\lsass\.exe$</field>
	<field name="win.eventdata.targetObject" type="pcre2">(?i)HKLM\\\\System\\\\CurrentControlSet\\\\Control\\\\Lsa\\\\(LsaPid|LsaCfgFlagsDefault|ProductType)$</field>
	<field name="win.eventdata.user" type="pcre2">(?i)^NT AUTHORITY\\\\SYSTEM$|^AUTORITE NT\\\\Système$</field>
    <description>Exclude noise: Multiple Sysmon Event 13 from lsass.exe on common registry key (e.g., during logon)</description>
    <options>no_full_log</options>
  </rule>
  
  <rule id="990009" level="1">
    <if_sid>112143</if_sid>
	<field name="win.eventdata.image" type="pcre2">(?i)\\\\C:\\\\Windows\\\\system32\\\\wbem\\\\WMIADAP\.EXE$</field>
	<field name="win.eventdata.targetObject" type="pcre2">(?i)HKLM\\\\System\\\\CurrentControlSet\\\\Services\\\\WmiApRpl\\\\Performance\\\\(PerfIniFile|Last Counter|Last Help|First Counter|First Help|Object List)$</field>
	<field name="win.eventdata.user" type="pcre2">(?i)^NT AUTHORITY\\\\SYSTEM$|^AUTORITE NT\\\\Système$</field>
    <description>Exclude noise: Multiple Sysmon Event 13 from WMIADAP.exe on common registry key (e.g., during logon)</description>
    <options>no_full_log</options>
  </rule>

  <rule id="990010" level="1">
    <if_sid>112143</if_sid>
	<field name="win.eventdata.image" type="pcre2">(?i)^C:\\\\Windows\\\\system32\\\\smss\.exe$</field>
	<field name="win.eventdata.targetObject" type="pcre2">(?i)HKLM\\\\System\\\\CurrentControlSet\\\\Control\\\\Session Manager\\\\Environment\\\\(NUMBER_OF_PROCESSORS|OS|PROCESSOR_ARCHITECTURE|PROCESSOR_LEVEL|PROCESSOR_IDENTIFIER|PROCESSOR_REVISION)$</field>
	<field name="win.eventdata.user" type="pcre2">(?i)^NT AUTHORITY\\\\SYSTEM$|^AUTORITE NT\\\\Système$</field>
    <description>Exclude noise: Multiple Sysmon Event 13 from smss.exe on common registry key (e.g., during logon)</description>
    <options>no_full_log</options>
  </rule>
  
  <rule id="990011" level="1">
    <if_sid>112143</if_sid>
	<field name="win.eventdata.image" type="pcre2">(?i)^C:\\\\Windows\\\\system32\\\\wevtutil\.exe$</field>
	<field name="win.eventdata.targetObject" type="pcre2">(?i)HKLM\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\WINEVT\\\\Channels\\\\[^\\\\]+\\\\(OwningPublisher|Enabled|Isolation|ChannelAccess|MaxSize|MaxSizeUpper|Type)$</field>
	<field name="win.eventdata.user" type="pcre2">(?i)^NT AUTHORITY\\\\SYSTEM$|^AUTORITE NT\\\\Système$</field>
    <description>Exclude noise: Multiple Sysmon Event 13 from wevtutil.exe on common registry key (e.g., during logon)</description>
    <options>no_full_log</options>
  </rule>

  <rule id="990012" level="3">
    <if_sid>61618</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)^C:\\\\Windows\\\\system32\\\\svchost\.exe$</field>
	<match>LocalService</match>
    <field name="win.eventdata.parentProcessGuid">{00000000-0000-0000-0000-000000000000}</field>
    <description>Ignore svchost.exe boot-time processes (false positive)</description>
  </rule>

  <!-- ========== Linux Custom Exclusion rules =========== -->

  <!-- Exclude Wazuh Legitimate command -->
  <rule id="990101" level="1">
  <if_sid>200110</if_sid>
  <field name="audit.command">node|wazuh-modulesd</field>
  <field name="audit.exe">/usr/share/wazuh|/var/ossec/bin/wazuh</field>
  <description>Exclude Wazuh Legitimate command.</description>
  <options>no_full_log</options>
  </rule>
  
  <!-- Exclude Filebeat Legitimate command -->
  <rule id="990102" level="1">
  <if_sid>200110</if_sid>
  <field name="audit.command">filebeat</field>
  <field name="audit.exe">/usr/share/filebeat/bin/filebeat</field>
  <description>Exclude Filebeat Legitimate command.</description>
  <options>no_full_log</options>
  </rule>
</group>
